# PPMI data and documentation are not redistributable: access is granted
# per-user via LONI under the PPMI Data Use Agreement. Keep all of it out of
# version control, including the dictionaries and user guides.
data/
extra/unused_data/

# Generated by the pipeline; regenerate with scripts/01 and scripts/02.
outputs/

# Experiment outputs. Same category as outputs/: derived from the pipeline and
# containing copies of the participant-level panel, so equally not
# redistributable. Regenerate by rerunning the relevant scripts.
experiments/

# Local pre-edit copies kept while reworking a file; git already holds the
# history, so these are never committed.
.backup_step2/

# Papers and the supervisor's proposal are third-party material. The only PDFs
# we generate ourselves are the progress reports.
*.pdf
!report/*.pdf
!extra/old_ood_project/*.pdf

__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
.venv/
venv/

# LaTeX build artefacts
*.aux
*.log
*.out
*.toc
*.synctex.gz
